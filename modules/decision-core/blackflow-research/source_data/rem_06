        "scene_ro5_res5a_3": {
          "id": "scene_ro5_res5a_3",
          "title": "孤钓",
          "description": "电弧拿出随身的糖果，老人将之穿在钩上。你抛出钓钩，顿感天旋地转——此时，你才知道什么叫做钓鳞还得自己抓。",
          "background": "pic_rogue_5_15",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_wait1_enter": {
          "id": "scene_ro5_wait1_enter",
          "title": "柳儿",
          "description": "柳儿是司岁台伥物房的吏员，主职乃是为你们一行人解析、开发各类伥物与仪具。她镇抚过许多器伥，随后将之投入对界园的探索与修缮，卓有成效。但对于是否要使用她那些毁誉参半的发明......你持保留意见，毕竟，总是免不了要支付一笔不小的......哦，她来了......手上捧着个木疙瘩？",
          "background": "pic_rogue_5_16",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_wait1_1": {
          "id": "scene_ro5_wait1_1",
          "title": "柳儿",
          "description": "乖乖付了账，她说这伥物能在岁识中大显神通。虽然她自己都说不准有什么效果，但拿都拿了......就走一步看一步吧。",
          "background": "pic_rogue_5_16",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_wait1_2": {
          "id": "scene_ro5_wait1_2",
          "title": "柳儿",
          "description": "曾有收了柳儿伥物的人白日目盲，还有人一条舌头只能吃出个蒜味。总之，为了免生祸端，你们婉言拒绝了她。",
          "background": "pic_rogue_5_16",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_camp2_enter": {
          "id": "scene_ro5_camp2_enter",
          "title": "烛堂",
          "description": "这座位于界园入口不远处的建筑是大炎游客怀揣崇敬、祈求好运的地方。人们点燃香烛，敬拜四方，将袅袅烟火留在此地。但闭园之后，这里便是司岁台经略界园的大本营。在来自大炎四方的烛火的照耀下，秉烛人将点燃属于自己的蜡烛，重申自己的职责，重拾心灵的力量。",
          "background": "pic_rogue_5_20",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_camp2_1": {
          "id": "scene_ro5_camp2_1",
          "title": "烛堂",
          "description": "在注视了烛光许久后，你离开了这里。",
          "background": "pic_rogue_5_20",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_camp2_2": {
          "id": "scene_ro5_camp2_2",
          "title": "烛堂",
          "description": "岁兽将醒，怒意的晶石从尖刺中萌生，游荡于思绪旁，时刻等待着摧垮你的心房。",
          "background": "pic_rogue_5_20",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_camp2_3": {
          "id": "scene_ro5_camp2_3",
          "title": "烛堂",
          "description": "只要留意心绪的波动，你自信能够通过这个被称作不息的怪物察觉岁兽超越因果的原理。",
          "background": "pic_rogue_5_20",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_end2_enter": {
          "id": "scene_ro5_end2_enter",
          "title": "收笔",
          "description": "司岁台的仪式到见字祠前就应当结束了，而你穿过祠堂，踏上易搭的天梯，来到地下深处，岁陵侧旁。周边碎石散落，就像是散架书简，弃置活字。你拿出望留下的谜团，将之掷入岁陵。",
          "background": "pic_rogue_5_24",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_end2_1": {
          "id": "scene_ro5_end2_1",
          "title": "收笔",
          "description": "云盘落子以为天，漆盘活字以为地，纵横经纬交织，相辅相成，生生在岁陵大门外又造了一处入口。思量不落于实字则混沌，理想不付诸行动则空妄。你要走进这拒人之地，并将之记录下来。",
          "background": "pic_rogue_5_24",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_sala2_enter": {
          "id": "scene_ro5_sala2_enter",
          "title": "南武群英会",
          "description": "这座擂台取自南武城集市正中的比武台。南武城自古商贸发达，也孕育了众多习武押镖的世家。为了拔得一年一度南武群英会的头筹，各武馆与镖局都会派出武艺最上乘的子弟与其他武者同台竞技。时至今日，虽然加入了诸多表演性质的比赛，群英会仍是南武城百姓尚武精神的具体体现。",
          "background": "pic_rogue_5_26",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_sala2_1": {
          "id": "scene_ro5_sala2_1",
          "title": "南武群英会",
          "description": "既然是群英会，就不只有单打，找好搭档，一起上吧。",
          "background": "pic_rogue_5_26",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_sala2_2": {
          "id": "scene_ro5_sala2_2",
          "title": "南武群英会",
          "description": "要事在身，还是不去凑这热闹为好。",
          "background": "pic_rogue_5_26",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_sala2_3": {
          "id": "scene_ro5_sala2_3",
          "title": "南武群英会",
          "description": "上擂前在满城同行前燃烛，可见这场比试之隆重。胜者誉满全城，败者黯淡离场。",
          "background": "pic_rogue_5_26",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest3_enter": {
          "id": "scene_ro5_rest3_enter",
          "title": "入暂亭",
          "description": "观览界园各处名胜，免不了人困腿乏，为了让游客驻足稍歇，此处便设了这凉亭。微风拂面，盛景在前，无论前路多么崎岖，至少在这方天地，可以安然歇息一阵。",
