        },
        "scene_ro5_sala1_3": {
          "id": "scene_ro5_sala1_3",
          "title": "夕江对擂",
          "description": "比试大多点到为止，但若燃了烛，便是仇怨已深，不倒不休的死斗。",
          "background": "pic_rogue_5_25",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double1_enter": {
          "id": "scene_ro5_double1_enter",
          "title": "石山",
          "description": "勾吴之地盛产奇石，水侵风蚀，姿态万千。并相堆叠，可成山峦，常用于园林与宫殿装饰。由勾吴石堆砌的石山，峻峭嶙峋，别有洞天。勾吴人素有“求石问路”的说法：在山脚燃香，向山中投钱，见得云雾四起，听得通宝叮当，讨个欢喜满堂。于是界园这座勾吴石山，每逢佳节，也是通宝满聚，财源四溢，让界园的工作人员头疼不已。",
          "background": "pic_rogue_5_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double1_1": {
          "id": "scene_ro5_double1_1",
          "title": "石山",
          "description": "通宝大多随着孔洞流至山脚，因此山间只有少量通宝，或是卡在石缝间，或是落在石洞中。既然留在此处已是百里挑一，那能带给他人的气运想必也是非同凡响。",
          "background": "pic_rogue_5_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double1_2": {
          "id": "scene_ro5_double1_2",
          "title": "石山",
          "description": "山脚边通宝堆得满满当当，其中还有些纸通宝甚至......弹珠？你从钱堆中取得一枚，仔细端详起来。",
          "background": "pic_rogue_5_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double1_3": {
          "id": "scene_ro5_double1_3",
          "title": "石山",
          "description": "石山拥财千千万，多一枚不多，少一枚不少，它只横卧此处，迎来送往，沉默不语。",
          "background": "pic_rogue_5_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_spring_enter": {
          "id": "scene_ro5_spring_enter",
          "title": "生机",
          "description": "一捧野火在空地上燃烧，不熄，不灭，不散，持续释放着光芒与热量。你靠近它，触摸它，也不会被灼烧。它并不是你的一部分，但其中蕴含的活力，你感到很熟悉。",
          "background": "pic_rogue_5_35",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_spring_1": {
          "id": "scene_ro5_spring_1",
          "title": "生机",
          "description": "火焰滋养着你的身心，也赋予了你前进的力量。在你走后，那捧火仍在燃烧。直到天地殒灭，直到万古更始，直到你下一次造访，直到......",
          "background": "pic_rogue_5_35",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_spring_2": {
          "id": "scene_ro5_spring_2",
          "title": "生机",
          "description": "那只是一捧野火罢了，不值得你浪费时间。",
          "background": "pic_rogue_5_35",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_portal1_enter": {
          "id": "scene_ro5_portal1_enter",
          "title": "地镇",
          "description": "界园内许多地方都能看到这如钉如尺的木柱，尽失他色，唯有黑白。周边的地面也受其影响，只余双色。人只消站在其中，便会五感尽失，意识活跃于身外，若是再进一步——",
          "background": "pic_rogue_5_21",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_portal1_1": {
          "id": "scene_ro5_portal1_1",
          "title": "地镇",
          "description": "你察觉到自己的意识不断膨胀......飞升......突破云端......俯瞰大地......就如同那古老的巨兽。",
          "background": "pic_rogue_5_21",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_portal1_2": {
          "id": "scene_ro5_portal1_2",
          "title": "地镇",
          "description": "在没有做好准备前，你不该贸然进入任何异常的地点。",
          "background": "pic_rogue_5_21",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_portal1_3": {
          "id": "scene_ro5_portal1_3",
          "title": "地镇",
          "description": "借着岁兽代理人们共同的权能，你在从未停止转动的仪器中，见到了神明苏醒的臆想。",
          "background": "pic_rogue_5_21",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_end1_enter": {
          "id": "scene_ro5_end1_enter",
          "title": "祠堂口",
          "description": "见字祠立于际山之巅，在界园光怪陆离的建筑群中反倒显得平常。这祠堂的名字由来此公干的秉烛人一代代口口相传，读音、语义虽无谬误，但若想要下笔撰写，只会像这祠堂匾额般空空荡荡。这里是你们任务的终点，界园主人已在此等候多时了。",
          "background": "pic_rogue_5_23",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_end1_1": {
          "id": "scene_ro5_end1_1",
          "title": "祠堂口",
          "description": "易看到你们手中的墨碑后，打开了见字祠的大门。“我还是第一次见到司岁台有人能把伥物琢磨到这种程度。请进吧，我来研碑，其他的按照流程来就行。”梁不停地摸着后脑勺，似乎是在苦闷待会儿怎么把闹出的动静给糊弄过去。",
          "background": "pic_rogue_5_23",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_end1_2": {
          "id": "scene_ro5_end1_2",
          "title": "祠堂口",
          "description": "裂兽尚且不能在天空中捕猎羽群，你们又如何能在界园伤害它的主人？但这就是仪式的意义——走入界园，代以岁名，以威震，以思抚，经由与岁兽代理人的战斗，将人类的权柄，通过整座园林——钉入岁骸的要害。",
          "background": "pic_rogue_5_23",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_enter": {
          "id": "scene_ro5_rest1_enter",
          "title": "入暂亭",
          "description": "观览界园各处名胜，免不了人困腿乏，为了让游客驻足稍歇，此处便设了这凉亭。微风拂面，盛景在前，无论前路多么崎岖，至少在这方天地，可以安然歇息一阵。",
          "background": "pic_rogue_5_40",
          "titleIcon": null,
          "subTypeId": 1,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_1": {
          "id": "scene_ro5_rest1_1",
          "title": "入暂亭",
          "description": "凉亭作枕，山川为榻，一时美梦，忧惧四散。",
          "background": "pic_rogue_5_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_2": {
          "id": "scene_ro5_rest1_2",
          "title": "入暂亭",
          "description": "一些准备好的餐食端正地放在石台上，每人都有饭一碗，菜几碟，还有搭配好的肉汤与糕饼。虽不丰盛，倒也能填饱肚子，为探索前路添了几分底气。",
          "background": "pic_rogue_5_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_3": {
          "id": "scene_ro5_rest1_3",
          "title": "入暂亭",
          "description": "你为随员们重新分配了职责，这样一来，你便能更有效地指挥队伍。",
          "background": "pic_rogue_5_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_4": {
          "id": "scene_ro5_rest1_4",
          "title": "入暂亭",
          "description": "麻羽虽小，五脏俱全，即使仪式简陋，只要诚心诚意，行仪周全，仍能点燃心中的烛光。",
          "background": "pic_rogue_5_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_5": {
