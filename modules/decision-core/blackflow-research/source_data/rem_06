        "scene_ro5_ent2_enter": {
          "id": "scene_ro5_ent2_enter",
          "title": "种因得果",
          "description": "一条苍色的巨兽蜷缩着身子，将一大片田地围在其中。天上下着小雨，其中混杂着一些微小的愿望，它们落入土地，生根发芽，长出了形色各异的东西。见你来了，她稍稍移动尾巴，留出了一个缺口。",
          "background": "pic_rogue_5_38",
          "titleIcon": null,
          "subTypeId": 1,
          "useHiddenMusic": false
        },
        "scene_ro5_ent2_1": {
          "id": "scene_ro5_ent2_1",
          "title": "种因得果",
          "description": "你退出田地后，黍重新合上了缺口。因果循环，你的愿因在田地里种出了各种各样的果实。但你有没有想过，是谁种下的因，收获了“让你前来”这一果实呢？",
          "background": "pic_rogue_5_38",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_ent2_2": {
          "id": "scene_ro5_ent2_2",
          "title": "种因得果",
          "description": "愿望落入土地，生出繁茂枝叶，巨兽帮你收割了这捆愿望，将之编成你能使用的物品。",
          "background": "pic_rogue_5_38",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_ent2_3": {
          "id": "scene_ro5_ent2_3",
          "title": "种因得果",
          "description": "田地中还有空地，你还能种下一些愿望，但过于轻浮的愿望，似乎不能在田地中结果。",
          "background": "pic_rogue_5_38",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_ent2_4": {
          "id": "scene_ro5_ent2_4",
          "title": "种因得果",
          "description": "愿望落入土地，生出金枝玉叶，巨兽帮你剪切了这捆愿望，仔细梳理，制成稀世绝代的工艺品。",
