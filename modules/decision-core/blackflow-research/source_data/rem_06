        "scene_ro5_res5a_enter": {
          "id": "scene_ro5_res5a_enter",
          "title": "孤钓",
          "description": "江面平静，一个老人正在岸边垂钓。他竹篓空空，钩上无饵，但似乎时时都有渔获。见你靠近，他给你让了个座位。“我这钓的，叫无鳞，下了钩，还得自己抓。”见你满脸疑惑，他把钓竿递给了你，“若是不信，自己试试？第一次钓，还是要饵的，有合适之物否？”",
          "background": "pic_rogue_5_15",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_res5a_1": {
          "id": "scene_ro5_res5a_1",
          "title": "孤钓",
          "description": "老人将票券揉成球穿在钩上。你抛出钓钩，顿感天旋地转——此时，你才知道什么叫做钓鳞还得自己抓。",
          "background": "pic_rogue_5_15",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_res5a_2": {
          "id": "scene_ro5_res5a_2",
          "title": "孤钓",
