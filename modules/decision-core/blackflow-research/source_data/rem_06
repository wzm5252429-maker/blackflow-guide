          "useHiddenMusic": false
        },
        "scene_ro5_bat4_1": {
          "id": "scene_ro5_bat4_1",
          "title": "千古鸭帝",
          "description": "你刚想发作，这鸭子居然塞了一把票券在你手里，似乎是在暗示你他和易的关系。看在这些票券的分上，你决定暂时放他一库兰塔。",
          "background": "pic_rogue_5_54",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_bat4_2": {
          "id": "scene_ro5_bat4_2",
          "title": "千古鸭帝",
          "description": "你遇到过这鸭子的手下，又目睹他在这里妖言惑众，绝不能让他逃了。",
