          "useHiddenMusic": false
        },
        "scene_ro5_heaven1_3": {
          "id": "scene_ro5_heaven1_3",
          "title": "珀",
          "description": "奇石一块，万古不移。",
          "background": "pic_rogue_5_31",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven1_4": {
          "id": "scene_ro5_heaven1_4",
          "title": "珀",
          "description": "巨珀石骸，自有乾坤。",
          "background": "pic_rogue_5_31",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven3_enter": {
          "id": "scene_ro5_heaven3_enter",
          "title": "榆蝶",
          "description": "一只榆木做的蝴蝶就停在不远处，前足紧紧抓着一根墨条。起初你还以为这是界园中的伥怪，但“蝴蝶”一开口，你便听到了柳儿的声音。她一研究完朔的武籍，便将成果带了过来。据她所说，这根墨条可“记忘却之事，现往日余痕”。但直到飞抵你们身边，这丫头才发现自己忘了雕墨。她虽然能用这只榆蝶雕完图案，但这笔开销......即使是富裕如她，也是一阵肉疼。",
          "background": "pic_rogue_5_32",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven3_1": {
          "id": "scene_ro5_heaven3_1",
          "title": "榆蝶",
          "description": "榆蝶用口器在墨上雕刻了一条盘岁，在点下眼睛时，“岁兽”突然褪去墨色一飞冲天，榆蝶则窝在墨条上将自己雕了进去。不一会儿，你获得了一根完好无损的墨条。鼓捣了半天，却是这么个结果，你也弄不明白柳儿在做些什么。看着天边蓄势待发的“岁兽”，你心里一阵嘀咕。",
          "background": "pic_rogue_5_32",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven3_2": {
          "id": "scene_ro5_heaven3_2",
          "title": "榆蝶",
          "description": "司岁台做事讲究规矩，柳儿总这么冒失可不行。但你也知道这丫头是个不撞南墙不回头的主，在她的苦苦“哀求”下，你还是决定拿出身上仅剩的财物支持她，为她的研究搏个机会。",
          "background": "pic_rogue_5_32",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven3_3": {
          "id": "scene_ro5_heaven3_3",
          "title": "榆蝶",
          "description": "司岁台做事讲究规矩，柳儿总这么冒失可不行。你从榆蝶身上摘下司岁台的令牌，好护住这个傻丫头的心神并将她安全送回地面。毕竟研究和突破可以不要，她的神志却不能迷失在这里。",
          "background": "pic_rogue_5_32",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven3_4": {
          "id": "scene_ro5_heaven3_4",
          "title": "榆蝶",
          "description": "榆蝶虽然几度停转，但最终还是用口器在墨上雕刻了一条盘岁，在点下眼睛时，“岁兽”突然褪去墨色一飞冲天，榆蝶则窝在墨条上将自己雕了进去。不一会儿，你获得了一根完好无损的墨条。鼓捣了半天，却是这么个结果，你也弄不明白柳儿在做些什么。看着天边蓄势待发的“岁兽”，你心里一阵嘀咕。",
          "background": "pic_rogue_5_32",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven3_5": {
          "id": "scene_ro5_heaven3_5",
          "title": "榆蝶",
          "description": "司岁台做事讲究规矩，柳儿总这么冒失可不行。但你也知道这丫头是个不撞南墙不回头的主，在她的苦苦“哀求”下，你还是决定拿出身上仅剩的财物支持她，为她的研究搏个机会。",
          "background": "pic_rogue_5_32",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_enter": {
          "id": "scene_ro5_heaven4_enter",
          "title": "点拨",
          "description": "一只巨兽越过你飞向前方，鳞色为翠，鬃毛却是桃红。他经过的地方，云朵相聚雨水相会，交织在一起化为棚顶；地上的草木疯长，如雕梁般触及云雨。无论是自然还是人造的事物都在他身边相合成了新的形态。他盘旋一阵后，落到你的面前，口出人言，询问你是否需要他的帮助。这个声音不是别人，正是界园的主人。",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_1": {
          "id": "scene_ro5_heaven4_1",
          "title": "点拨",
          "description": "一只云朵变成的羽儿在他角上停了一会，倏地又变作一池鳞，消失在漫天汪洋中。他能以外物助你在此间停留，也可以教些法子，让你的意识不那么快地溃散回地面。理所当然的，你得付出些东西。",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_2": {
          "id": "scene_ro5_heaven4_2",
          "title": "点拨",
          "description": "他向来不擅还价，自然也不懂讲价的道理，可是，哪有人上来就要对方一半财富的？",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_3": {
          "id": "scene_ro5_heaven4_3",
          "title": "点拨",
          "description": "他向来不擅还价，自然也不懂讲价的道理，可是，哪有人上来就要想法这种虚无缥缈的东西的？",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_4": {
          "id": "scene_ro5_heaven4_4",
          "title": "点拨",
          "description": "刚刚游走的池鳞忽地出现，在你面前化作一个指环，绕上了手指，你明显感觉到自己的思维清晰了不少。",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_5": {
          "id": "scene_ro5_heaven4_5",
          "title": "点拨",
          "description": "他虽是你们的帮手，但也是岁兽代理人，你不能冒险去寻求他的帮助，更不能去满足他无理的请求。",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_6": {
          "id": "scene_ro5_heaven4_6",
          "title": "点拨",
          "description": "他向来不擅还价，自然也不懂讲价的道理，可是，哪有人上来就要想法这种虚无缥缈的东西的？",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_7": {
          "id": "scene_ro5_heaven4_7",
          "title": "点拨",
          "description": "他向来不擅还价，自然也不懂讲价的道理，可是，哪有人上来就要对方所有财富的！",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven4_8": {
          "id": "scene_ro5_heaven4_8",
          "title": "点拨",
          "description": "他教了你几句口诀，并邀请你同游一段。在一阵翱翔后，你明显感觉到身体更加轻快了。",
          "background": "pic_rogue_5_33",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_enter": {
          "id": "scene_ro5_heaven5_enter",
          "title": "应“蕴”而生",
          "description": "莫佚在这里仍保持着人形，岁兽似乎并没有对她造成什么影响。她知道你进不了门，于是在学堂的边缘接待了你。她很喜欢这里，因为在此处，无论人、兽，还是伥，都会显现出自己最本真的那一面。而交流的第一步，便是坦诚。“我正需要几枚铜钱喂伥，或许你愿意慷慨解囊？”",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_1": {
          "id": "scene_ro5_heaven5_1",
          "title": "应“蕴”而生",
          "description": "你其实心底里一直不太相信这个山海众成员，于是你起身飞去，把她留在了原地。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_2": {
          "id": "scene_ro5_heaven5_2",
          "title": "应“蕴”而生",
          "description": "“蒲先生教了半辈子的伥，教它们化人形做工挣钱在这人世立足。或许经年累月，真有什么事物能受其感召，正儿八经当上个学徒，入天师府，拜大学宫，最后为人师表，授业论道。”看着一地的铜钱，莫佚如是说道。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_3": {
          "id": "scene_ro5_heaven5_3",
          "title": "应“蕴”而生",
          "description": "“单论模仿，我是觉得伥要强过我们许多。不知它们会不会理解描摹和学习的区别。”莫佚收起地上的铜钱，将之合成一枚归还给了你。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_4": {
          "id": "scene_ro5_heaven5_4",
          "title": "应“蕴”而生",
          "description": "“感受岁的灵蕴当然是它们成伥的条件，但若只需如此，那大地上早该被伥填满了。”硬币落在地上，似乎都生出灵性，它们迫不及待地互相堆叠，仿佛本就是一体。“万物都有自己的脾性，成伥与否，都是它们自己的选择。”",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_5": {
          "id": "scene_ro5_heaven5_5",
          "title": "应“蕴”而生",
          "description": "莫佚取来一根线，钱伥们很自然地串到了一起。“那我就伥归原主了，愿你好生待它们。”",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_6": {
          "id": "scene_ro5_heaven5_6",
          "title": "应“蕴”而生",
          "description": "“你们常说伥怪凶戾，可就像这把撒下的铜钱，哪有那么多生灵，生来就走在歪路上？”说是喂食，但伥们似乎更像是在钱币中寻找同伴。“芸芸众生，总有能容下它们的地方。”",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_7": {
          "id": "scene_ro5_heaven5_7",
          "title": "应“蕴”而生",
          "description": "半晌，一些钱币生出灵性，一些落在地上，于是莫佚把地上的钱交还给了你，顺便奉上了自己的票券。看来她在界园出入，并不需要这个。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_8": {
          "id": "scene_ro5_heaven5_8",
          "title": "应“蕴”而生",
          "description": "透过这枚合一的通宝，你能看见学堂里努力学习的伥们。它们对于人的理解，或许就如人对它们的理解那样，单是学个皮毛，就得花上半载。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_9": {
          "id": "scene_ro5_heaven5_9",
          "title": "应“蕴”而生",
          "description": "虽在一根线上为一体，钱伥们却是各有各的主意，就像身居八方的人们那样，想让它们步调一致，也只能靠你牵着线从中协调了。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven5_10": {
          "id": "scene_ro5_heaven5_10",
          "title": "应“蕴”而生",
          "description": "那三枚钱币站在莫佚手上讲了好多见闻，许久之后，一本名为《三枚》的志怪小说出现在了大街小巷间。",
          "background": "pic_rogue_5_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven7_enter": {
          "id": "scene_ro5_heaven7_enter",
          "title": "老贼羽",
          "description": "你见过巨兽，却从未见过如此巨大的羽兽。火焰攀附着它的羽毛，轰鸣之声追不上它的残影。它围着你绕了好几圈，直到你的毛发都被烫卷，它才轻巧地停在你面前的巨木上，像是看一条小虫般看着你。“后生，这园子里的东西不好对付吧？”它打量了你一番，眼睛却瞄向了你的荷包，“降魔平伥的宝贝我这儿可不少，给你一件倒也无妨，想要么？”",
          "background": "pic_rogue_5_34",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven7_1": {
          "id": "scene_ro5_heaven7_1",
          "title": "老贼羽",
          "description": "你大概能猜到她的身份，因此毫无戒备，没想到这老顽童把法宝丢给你的时候，顺手就抓住你的荷包，飞得无影无踪。幸好火焰烧毁了荷包一角，有些钱币零星落在你眼前，随之落下的，还有逐渐远去的一句话——“见了我这宝贝的伥怪就没有不逃的，后生，好生用着吧，等你行仪归来，我自然会把这荷包还给你。”",
          "background": "pic_rogue_5_34",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven7_2": {
          "id": "scene_ro5_heaven7_2",
          "title": "老贼羽",
          "description": "俗话说，“无事献殷勤，非奸即盗”，即使熟人也应当警惕。当她把法宝丢给你的时候，你下意识护住了自己的荷包，然而，她还是精准地抓出一把钱币，飞到了你的后方。“好后生，”她似乎很开心，鸣叫了好几声，“这才是司岁台小儿该有的样子，我就先拿这钱去吃碟小菜了，等你行仪归来，记得到天师府把东西还我。”耳边风声未响，她就消失了。",
          "background": "pic_rogue_5_34",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven7_3": {
          "id": "scene_ro5_heaven7_3",
          "title": "老贼羽",
          "description": "既然是老天师的宝物，想必差不到哪里去，只是这么一搞，白白少了许多盘缠。怪不得总有人说，老而不死是为......你环顾四周，似乎还隐隐听得到些灼烧声，于是把最后一个字吞了下去。",
          "background": "pic_rogue_5_34",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven8_enter": {
          "id": "scene_ro5_heaven8_enter",
          "title": "百氏之乱",
          "description": "大地陷于战争，势力割据林立，豪强四起。你立于云端，俯瞰大地。这段历史你非常熟悉，在课本上，你已阅读过无数次，可如今真切地观览它，才知其中的悲欢离合。",
          "background": "pic_rogue_5_42",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven8_1": {
          "id": "scene_ro5_heaven8_1",
          "title": "百氏之乱",
          "description": "你投下自己的影响，支持你所熟知的英雄们，期盼他们能获得一个美满的结局。",
          "background": "pic_rogue_5_42",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven8_2": {
          "id": "scene_ro5_heaven8_2",
          "title": "百氏之乱",
          "description": "一把火，从铁索连船烧到八百里连营，烧毁城市国都，烧尽书简殿宇。百氏之乱由炎而发，由炎结束，这是早有定论的事。只是不知王侯将相的赫赫战功，是否能盖得住困苦生灵的阵阵哭号。",
          "background": "pic_rogue_5_42",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven8_3": {
          "id": "scene_ro5_heaven8_3",
          "title": "百氏之乱",
          "description": "历史如云烟，你并不能将自己的影响投射至结局，但在与历史人物的相处中，你变得更加知人善任。不知当初如你这般帮助所选之人获得胜利的巨兽，心中是否也曾涌现过这样的傲气与自豪？",
          "background": "pic_rogue_5_42",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven11_enter": {
          "id": "scene_ro5_heaven11_enter",
          "title": "不速之客",
          "description": "你的到来把正在天地间泼墨挥毫的巨兽吓了一跳，这里是她的画境，而她根本就没有邀请过你！......或许，你该给她道个歉。",
          "background": "pic_rogue_5_36",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven11_1": {
          "id": "scene_ro5_heaven11_1",
          "title": "不速之客",
          "description": "见了东西之后，她没有立即收下，也没有出言拒绝，踌躇了半天，重峦消散，烟云聚成人形。夕说这东西且算是她留给大炎那帮老东西的印信，既然流落到了你手上，她多少也得把这个差给交了。“你想要什么？”她尽量掩饰着自己的不耐烦。",
          "background": "pic_rogue_5_36",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven11_2": {
          "id": "scene_ro5_heaven11_2",
          "title": "不速之客",
          "description": "你似乎是从界园的某幅画卷进到的这里。夕知道易有收藏她的画作，倒也没有太过惊讶，但对于司岁台的人，夕向来是没有好脸色的，她允许你在此休息，但不代表她能容忍你，这不，她早就换了片画境，消失得无影无踪了。",
          "background": "pic_rogue_5_36",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven11_3": {
          "id": "scene_ro5_heaven11_3",
          "title": "不速之客",
          "description": "对于这模棱两可的需求，夕极力忍住了自己的情绪，转头进了书屋。在不知多少个春秋后，她才从书屋里走出来，丢给你一个卷轴，然后挥笔把你从画卷里推了出去。",
          "background": "pic_rogue_5_36",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven11_4": {
          "id": "scene_ro5_heaven11_4",
          "title": "不速之客",
          "description": "见了东西之后，她没有立即收下，也没有出言拒绝，踌躇了半天，重峦消散，烟云聚成人形。夕说这东西且算是她留给大炎那帮老东西的印信，既然流落到了你手上，她多少也得把这个差给交了。“你想要什么？”她尽量掩饰着自己的不耐烦。",
          "background": "pic_rogue_5_36",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_enter": {
          "id": "scene_ro5_double6_enter",
          "title": "禳解",
          "description": "禳，祛也；解，消也。人怕灾祸，所以总想做点什么求个心安。此处或许正是这样一个好地方：水聚天心，四水归堂，再置一门海，聚财纳阳，不露不泄，缸中又有白莲，底泥虽浊，水却至清。如此甘露，若饮上一口，想必对人也是大有裨益。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_1": {
          "id": "scene_ro5_double6_1",
          "title": "禳解",
          "description": "缸中水苦涩无比，但你刚咽下，缸中那株含苞的莲花便似睡醒了一般，摇摇晃晃地绽开重瓣。一颗殷红的露珠沿着花瓣滑落，你忙用手去接。刚落入掌心，你便发觉触感不对。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_2": {
          "id": "scene_ro5_double6_2",
          "title": "禳解",
          "description": "那水虽然清澈，但极其苦涩，你还从中隐约嗅出一丝腥气。缸中那株叫不出名字的莲花轻轻颤抖，但并没有要绽放的迹象。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_3": {
          "id": "scene_ro5_double6_3",
          "title": "禳解",
          "description": "你收起了得来之物。低头再看向水缸时，你发现又有一个花苞钻出了水面，此刻正怯生生地朝你摇晃。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_4": {
          "id": "scene_ro5_double6_4",
          "title": "禳解",
          "description": "禳，祛也；解，消也。人怕灾祸，所以总想做点什么求个心安。此处或许正是这样一个好地方：水聚天心，四水归堂，再置一门海，聚财纳阳，不露不泄，缸中又有白莲，底泥虽浊，水却至清。如此甘露，若饮上一口，想必对人也是大有裨益。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_6": {
          "id": "scene_ro5_double6_6",
          "title": "禳解",
          "description": "你将得来之物仔细收好。再看向水缸中，只见水面清澈无比，可惜其中有厚厚一层淤泥阻碍了视线，说不清里面藏着些什么。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_5": {
          "id": "scene_ro5_double6_5",
          "title": "禳解",
          "description": "你忍着苦味再喝下一口，水面便似沸腾一般涌出许多气泡。片刻后，一片车轮大小的莲叶顶出了水面，咔嚓一声折断了叶柄，正好掉进你怀里。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_7": {
          "id": "scene_ro5_double6_7",
          "title": "禳解",
          "description": "你付出了代价，也得到了些许收获，想着这些东西将来也许能派上用场，你多少有些宽慰。“这算是禳解吗？”你扯着沙哑的嗓子问同伴。但他们也说不清。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_8": {
          "id": "scene_ro5_double6_8",
          "title": "禳解",
          "description": "喝下一口缸中水，苦涩滋味让你舌根发麻。你等了好一会儿也没见缸中有什么动静。正当你准备转身离开时，缸中传来一阵尖锐刺耳的刮擦声，随后，两件物事缓缓浮出水面。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_9": {
          "id": "scene_ro5_double6_9",
          "title": "禳解",
          "description": "你惊喜不已，趴在水缸上想看清淤泥中还藏着些什么，但水面倒映出的一张煞白的脸将你吓得倒退几步。经同伴提醒，你才发现自己的嘴巴已经失去了知觉，几乎说不出话来。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6_10": {
          "id": "scene_ro5_double6_10",
          "title": "禳解",
          "description": "这次你干脆将整个脑袋都埋进水里，大口吞咽。水缸忽然剧烈抖动起来。随着一声似有似无的叹息，水缸裂成了两半，莲花也瞬间枯萎。你不死心地在淤泥中翻找，终于被你找出两样造型奇特的东西，但以你的力气只拿得起其中一件。",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double6b_enter": {
          "id": "scene_ro5_double6b_enter",
          "title": "禳解",
          "description": "缸中之物名唤“扼腕”，背生莲梗，身埋缸底，须以江畔染血之泥养之，喜静勿动，奇物自来。界园主人没指望它真能引来什么奇物，只是图那莲花洁白可观。“扼腕”喜食人气，或是壮士断腕的豪气，或是断腕后扼腕求生的惧气，人若是凑得太近，它食了太多贪气，便会乐极而死，腹中奇物尽散，声如哀叹，界园主人曾记：“此乃‘扼腕叹息’。”",
          "background": "pic_rogue_5_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
