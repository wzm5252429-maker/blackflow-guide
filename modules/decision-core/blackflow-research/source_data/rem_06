          "useHiddenMusic": false
        },
        "scene_ro5_startbuff_enter": {
          "id": "scene_ro5_startbuff_enter",
          "title": "行动奖励",
          "description": "你的上一次探索突破了至少两层困难，这一次可以获得更多支援。",
          "background": null,
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
