          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_bat4_3": {
          "id": "scene_ro5_bat4_3",
          "title": "千古鸭帝",
          "description": "也不知怎的，你居然觉得他说得还挺可行。“园林乐园”，实在是独一无二，于是你也加入了投资大军。",
          "background": "pic_rogue_5_54",
