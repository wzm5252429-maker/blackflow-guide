          "title": "掷地有声",
          "description": "钱币落下，正如你所预料。令放声大笑消失在了云雾间，只为你留下一只满是财宝的觞。",
          "background": "pic_rogue_5_39",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_ent3_4": {
