          "title": "入暂亭",
          "description": "你们围坐一圈，分享着家乡的逸闻。",
          "background": "pic_rogue_5_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_rest1_6": {
