          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_heaven1_enter": {
          "id": "scene_ro5_heaven1_enter",
          "title": "珀",
          "description": "东海之滨有一巨珀，人不可近，灾不可移。四百年为一周天——百年焚烟，百年化泪，百年累痕，百年裹石，回环往复。",
          "background": "pic_rogue_5_31",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
