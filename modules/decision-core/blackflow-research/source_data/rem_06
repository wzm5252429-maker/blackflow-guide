          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_ent3_2": {
          "id": "scene_ro5_ent3_2",
          "title": "掷地有声",
          "description": "钱币入觞，巨兽卷起晃荡几下，随后将之高高举起，又歪过头来，询问你的猜测。“潺潺流水，如常乎？如锋乎？如簇乎？”",
