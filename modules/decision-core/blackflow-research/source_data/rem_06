        },
        "scene_ro5_double5_enter": {
          "id": "scene_ro5_double5_enter",
          "title": "同心",
          "description": "一颗做工精致的玉石同心球出现在你眼前。每一层都薄如蝉翼，层层叠叠，似有什么物件包裹其中。",
          "background": "pic_rogue_5_43",
          "titleIcon": "",
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5_1": {
          "id": "scene_ro5_double5_1",
          "title": "同心",
          "description": "天边的球体开始缓缓旋转，你抓了片地上的残瓦作为纪念便立刻跳出。出去后你仔细端详，才发现这一片瓦是用水晶磨成的，放在身边，或许能帮你抵挡些什么。",
          "background": "pic_rogue_5_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5_2": {
          "id": "scene_ro5_double5_2",
          "title": "同心",
          "description": "用一旁的玉簪拨弄许久，才能看到其中的奥妙：正中心嵌着通体透明的水晶珠，内里雕刻了一整座小镇。你仔细端详，当心察看，一抬头，发现自己已是珠中人。",
          "background": "pic_rogue_5_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5_3": {
          "id": "scene_ro5_double5_3",
          "title": "同心",
          "description": "由电弧带头，你们谨慎地向前探索。在察知村民们的敌意后，电弧试图找出不起冲突便能离开的方法，只是，在探查的时候，你们还是被村民们发现了。",
          "background": "pic_rogue_5_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5_4": {
          "id": "scene_ro5_double5_4",
          "title": "同心",
          "description": "往前走上几步，便遇见了村民，然而他们见着你，就像是见了仇人那般，领头的人一吹哨，整座小镇的生物就都动了起来。",
          "background": "pic_rogue_5_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5_5": {
          "id": "scene_ro5_double5_5",
          "title": "同心",
          "description": "很快，电弧就带着一些礼品回来了。在她的交涉下，村民们改换认知并提供了帮助。而后，当谈及他们这方天地时，村民们反复表示，这里便是他们曾经心心念念的桃源乡，除了将他们送来这里的神明，只有“威胁”才会由外而来。最终，你们逃出了同心球，但村民们说起的缘由，却令你迷惑了许久。",
          "background": "pic_rogue_5_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5_6": {
          "id": "scene_ro5_double5_6",
          "title": "同心",
          "description": "天边的球体开始缓缓旋转，若是立刻跳出，除了摔个趔趄外，倒也没什么损失......持续转动数分钟后，那颗水晶珠再次被层层包裹，看不清虚实。",
          "background": "pic_rogue_5_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5b_enter": {
          "id": "scene_ro5_double5b_enter",
          "title": "同心",
          "description": "一颗做工精致的玉石同心球出现在你眼前。每一层都薄如蝉翼，层层叠叠，似有生命包裹其中。这是易的造物，你决定仔细看看。",
          "background": "pic_rogue_5_44",
          "titleIcon": "",
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5b_1": {
          "id": "scene_ro5_double5b_1",
          "title": "同心",
          "description": "村民们震惊于你的身形与气息，纷纷跪倒在青石路上，并为你奉上了一些特产。然而，当你劝说他们离开时，村民们却坚定地一口回绝——他们自认已找到能永世躲避战乱的桃源乡，分外感念那位“神明”的恩慈，他们善意地拒绝了你，并恳请你不要向任何人透露他们的行迹。“这是我们这些人共同的心愿。”为首的老者这样说道。",
          "background": "pic_rogue_5_44",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5b_2": {
          "id": "scene_ro5_double5b_2",
          "title": "同心",
          "description": "一阵旋转后，你看到了水晶珠中的小镇。四季分明，日夜轮替，生活在其中的人怡然自得，似乎没有任何疑虑与烦恼。一时间，你也不清楚这究竟是福祉还是惩罚。",
          "background": "pic_rogue_5_44",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5b_3": {
          "id": "scene_ro5_double5b_3",
          "title": "同心",
          "description": "电弧顺利进入了小镇，并按照你先前的吩咐行事。",
          "background": "pic_rogue_5_44",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5b_4": {
          "id": "scene_ro5_double5b_4",
          "title": "同心",
          "description": "在你决定不再干涉后，同心球便慢慢转动，重新将小镇与村民包裹其中。你琢磨了许久，才想明白这颗球承载的，正是小镇村民集体的意识。也就是说，若是他们不想出来，同心球便会永远将他们“护”在其中。",
          "background": "pic_rogue_5_44",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_double5b_5": {
          "id": "scene_ro5_double5b_5",
          "title": "同心",
          "description": "电弧带回了满满一箱补给，并为你讲述了那座小镇所发生的事——为了躲避战乱，几户人家在人迹罕至之处建立了一座小镇。虽然很少有外人前来，但对于外来者的忌惮一直折磨着村民。他们想生活在永久不被打扰的安乐之地，而一位前来寻宝的“神明”回应了他们。村民们献上了古老的器皿，并得以在这玲珑巧物中世世代代地生活下去。",
          "background": "pic_rogue_5_44",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_bat1_enter": {
          "id": "scene_ro5_bat1_enter",
          "title": "护鸭金刚",
          "description": "这乌萨斯人只说自己为老板服务，对其他问题则一概不回应。不管他口中的老板是谁，上头有没有人，他都不应当留在界园内。",
