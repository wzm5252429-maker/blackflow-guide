        },
        "scene_ro5_bat3_4": {
          "id": "scene_ro5_bat3_4",
          "title": "滚圆财神",
          "description": "电弧上前和他攀谈，顺利弄到了一份赠品，你尝了尝，味道还不错。",
          "background": "pic_rogue_5_53",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_bat4_enter": {
          "id": "scene_ro5_bat4_enter",
          "title": "千古鸭帝",
          "description": "一只鸭子在各种塑像、器物和伥怪间游走，嘴里滔滔不绝说着要将这里改造成更受欢迎的景区的“宏伟”设想——更多娱乐设施、更多歌舞表演，以及更多互动服务......这实在是......",
          "background": "pic_rogue_5_54",
