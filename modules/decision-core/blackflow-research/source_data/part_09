          "useHiddenMusic": false
        },
        "scene_ro6_evacuate_enter": {
          "id": "scene_ro6_evacuate_enter",
          "title": "三重身",
          "description": "你循着奇妙的荧光猫爪印找到了它们。虽然体型与年龄各异，但很明显它们是同一只猫，不过你只能和其中一只对话。 “你已经找到了我留下的印记，”唯一能言的那只猫说，“说明你已经对此时此刻此处丧失了兴趣。很没意思？想体验未来吗？去到那时那刻那处吧。”",
          "background": "pic_rogue_6_28",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_evacuate_1": {
          "id": "scene_ro6_evacuate_1",
          "title": "三重身",
          "description": "爪印随着你前进的步伐一个个消失，你走出了那迷宫一般的景色，眼前豁然开朗——这确实是一条近路。",
          "background": "pic_rogue_6_28",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_evacuate_2": {
          "id": "scene_ro6_evacuate_2",
          "title": "三重身",
          "description": "你不相信这只猫，于是离开此处，自寻出路。",
          "background": "pic_rogue_6_28",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat1_enter": {
          "id": "scene_ro6_bat1_enter",
          "title": "思乡心切",
          "description": "一阵哭泣声吸引了你，在什么怪事都可能发生的树海中，你本不想理会，可那声音越来越大，扰得你心烦。你找到哭声源头，原来是一只泪眼婆娑的狗。你大声询问它为何哭泣，得知它已经很久没有回家乡了，却在家门口迷了路。",
          "background": "pic_rogue_6_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat1_1": {
          "id": "scene_ro6_bat1_1",
          "title": "思乡心切",
          "description": "这只狗忸怩着不肯离去，你不想和这个烦人的家伙纠缠，是时候给它点颜色瞧瞧了。",
          "background": "pic_rogue_6_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat1_2": {
          "id": "scene_ro6_bat1_2",
          "title": "思乡心切",
          "description": "你简单安慰了它几句，权当休息，之后的事还是交给它自己吧。",
          "background": "pic_rogue_6_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat2_enter": {
          "id": "scene_ro6_bat2_enter",
          "title": "划算买卖",
          "description": "一只鼠拦住了你的去路，它想收购你身上的所有东西——手电筒、防护服、雇主资料，甚至一段准备带进坟墓的经历。它的言辞没有一点礼貌可言，仿佛已经认定你无法走出这片树海，唯一能做的就是给家里寄去一些抚恤金。",
          "background": "pic_rogue_6_2",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat2_1": {
          "id": "scene_ro6_bat2_1",
          "title": "划算买卖",
          "description": "它见你来者不善，利索地从身后掏出了武器。看来已经有不少人跟它达成了收购协议，无论是自愿的还是被迫的。",
          "background": "pic_rogue_6_2",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat2_2": {
          "id": "scene_ro6_bat2_2",
          "title": "划算买卖",
          "description": "你不想理会它，离开了这里。利益能推着商人去任何地方做生意，连诡异的黑流树海也不例外。或许它会在这里长个教训，又或者，大赚一笔。",
          "background": "pic_rogue_6_2",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat3_enter": {
          "id": "scene_ro6_bat3_enter",
          "title": "鸭托邦",
          "description": "树海中，行为奇怪的小动物三五成群，但最诡异的，莫过于一只鸭子站在黑池边，看着一只只外形一模一样的鸭子从池子里抖着羽毛钻出来。你凑近黑池，想知道这里到底发生了什么，一头沉默的熊拦住了你。",
          "background": "pic_rogue_6_3",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat3_1": {
          "id": "scene_ro6_bat3_1",
          "title": "鸭托邦",
          "description": "你的呛声没有引起鸭子的兴趣，但你眼前的熊仿佛接收到了一个指令——你不是潜在客户，不用对你客气。",
          "background": "pic_rogue_6_3",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat3_2": {
          "id": "scene_ro6_bat3_2",
          "title": "鸭托邦",
          "description": "你手中的源石锭吸引了带头鸭子和鸭群的兴趣，现在你彻底打搅了正在成形的鸭托邦。没有指挥下属，带头鸭子用翅膀压低帽子，朝你飞速扑来！他精通的可不只是经商之道。",
          "background": "pic_rogue_6_3",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat3_3": {
          "id": "scene_ro6_bat3_3",
          "title": "鸭托邦",
          "description": "离开时，你走到了黑池的另一边，发现这里散落着日用品、钱包，还有向鸭子借款的欠条。一排人类的鞋印通向黑池，一排鸭子的蹼印出现在对岸，你瞬间明白了一切，开始庆幸自己没有打搅这场“特别”的讨债行动。",
          "background": "pic_rogue_6_3",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat4_enter": {
          "id": "scene_ro6_bat4_enter",
          "title": "传奇团伙",
          "description": "一支商队大摇大摆地出现在你面前，没有竞争对手，这些家伙赚得盆满钵满。鸭子坐在货车副驾驶座上，指挥开车的老鼠朝你鸣笛，要求你为即将崛起的商业帝国让道。",
          "background": "pic_rogue_6_4",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat4_1": {
          "id": "scene_ro6_bat4_1",
          "title": "传奇团伙",
          "description": "货车上的成员纷纷下车，面色不善。这些家伙最擅长扫除商业道路上的阻碍，解决不了问题那就直接解决制造问题的人。",
          "background": "pic_rogue_6_4",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat4_2": {
          "id": "scene_ro6_bat4_2",
          "title": "传奇团伙",
          "description": "轮胎发出了古怪的漏气声，引得你哈哈大笑。再次抬起头时，你发现商队的所有成员都拿起了武器，气势汹汹地朝你走来。",
          "background": "pic_rogue_6_4",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat4_3": {
          "id": "scene_ro6_bat4_3",
          "title": "传奇团伙",
          "description": "你交出了“保证金”，再三发誓自己永远不会阻挡鸭子先生的财路。货车喷了你一身尾气，放着热辣的舞曲，大摇大摆地开走了。",
          "background": "pic_rogue_6_4",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_enter": {
          "id": "scene_ro6_bat5_enter",
          "title": "湖中仙女",
          "description": "你在林中听到一阵温柔的吟唱声，声音的来源坐于浅湖中心的礁石上，手捧一束鲜艳的花，身下的湖水波光粼粼。她正招手邀请你过去。",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_1": {
          "id": "scene_ro6_bat5_1",
          "title": "湖中仙女",
          "description": "“不少人都想找到湖中的秘宝，但总是缺乏诚意。”仙女用手将湖水拨弄出涟漪，露出腕上闪亮的手镯，“你愿意展现你的虔诚吗？”",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_2": {
          "id": "scene_ro6_bat5_2",
          "title": "湖中仙女",
          "description": "这片树海中难以解释的事太多，连眼见都不一定为实。你没有再看她一眼，快步离开了。",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_3": {
          "id": "scene_ro6_bat5_3",
          "title": "湖中仙女",
          "description": "你看清了美丽仙女的倒影，那是一个似蛇似蝎的怪物，湖水映出了她的真面目，而她无法再欺骗你了。",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_4": {
          "id": "scene_ro6_bat5_4",
          "title": "湖中仙女",
          "description": "她的话语焉不详，而你不想继续纠缠下去。",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_5": {
          "id": "scene_ro6_bat5_5",
          "title": "湖中仙女",
          "description": "她从湖中捞出一块磁石，看起来并不怎么值钱。“或许我们可以把它丢回湖里，找出更好的东西，你愿意展现你的虔诚吗？”",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_6": {
          "id": "scene_ro6_bat5_6",
          "title": "湖中仙女",
          "description": "磁石被丢进湖里，仙女的手伸进湖水，这次她捞出一块手表，只是表盘已经破损，看起来也不怎么值钱。“或许我们可以把它丢回湖里，找出更好的东西，你愿意展现你的虔诚吗？”",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_7": {
          "id": "scene_ro6_bat5_7",
          "title": "湖中仙女",
          "description": "手表被丢进湖里，仙女的手伸进湖水，这次她捞出了一条腐烂的胳膊，破损的手表正牢牢箍在肿大的手腕上。你低头看向仙女在湖中的倒影——一只似蛇又像蝎的生物。周围的景色变幻了，蓝色的火焰将你们围了起来，仙女扭曲的声音萦绕在耳畔：“ ¿吗诚虔的你现展意愿你”",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_8": {
          "id": "scene_ro6_bat5_8",
          "title": "湖中仙女",
          "description": "你的虔诚让仙女十分感动，她将身下的湖水搅起一阵波涛，从水中捞出一件礼物送给你。",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat5_9": {
          "id": "scene_ro6_bat5_9",
          "title": "湖中仙女",
          "description": "你拿着仙女从湖里打捞出的宝物，深感虔诚在此地的重要性。",
          "background": "pic_rogue_6_5",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro6_bat6_enter": {
          "id": "scene_ro6_bat6_enter",
          "title": "洞中宝",
          "description": "树洞在黑流树海中随处可见，但你还是被一片在漆黑中闪烁的金光吸引住了。那些金灿灿的东西仿佛一张张大大的笑脸，正在欢迎你去一探究竟。",
          "background": "pic_rogue_6_6",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
