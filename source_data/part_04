          "title": "原初异途",
          "description": "猎手取过奇物，继续向山脉深处进发......",
          "background": "pic_rogue_3_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_sacrifice1_2": {
          "id": "scene_ro4_sacrifice1_2",
          "title": "原初异途",
          "description": "猎手取过奇物，继续向山脉深处进发......",
          "background": "pic_rogue_3_43",
