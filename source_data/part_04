        },
        "scene_ro4_normal12_3": {
          "id": "scene_ro4_normal12_3",
          "title": "表达欲",
          "description": "在你的退让下，这个故事很快被撕扯成了虚无，再也没有东西可以毁坏的时候，死魂灵们才心满意足地消失了，只给你留下一块故事的残骸。你叹了口气，捡起这块残骸，开始想象新的故事。",
          "background": "pic_rogue_4_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_chest2_enter": {
          "id": "scene_ro4_chest2_enter",
          "title": "巴别塔雇员",
          "description": "一位被称作大鲍勃的人带着家乡的亲朋好友承包了这一处巴别塔据点以供来往人员休整，但由于他们都穿着同样的装备，你也不太清楚哪个是大鲍勃本人。当你休整完毕准备出发时，一位巴别塔雇员为你送上了补给。",
          "background": "pic_rogue_4_27",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_chest2_1": {
          "id": "scene_ro4_chest2_1",
          "title": "巴别塔雇员",
          "description": "有人说大鲍勃曾是个讲义气的佣兵，有人说大鲍勃曾是个豪爽的富商，还有人说大鲍勃以前只是个蹲在监狱里发霉的囚犯。但在你看来，他只是一个努力生活的普通人，一个萨卡兹们的好兄弟。",
          "background": "pic_rogue_4_27",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_chest2_2": {
          "id": "scene_ro4_chest2_2",
          "title": "巴别塔雇员",
          "description": "你梦寐以求的东西就在那位巴别塔雇员的手上，你只记得自己感叹过几句，从没想过会美梦成真，究竟是谁帮你实现了这个愿望呢？",
          "background": "pic_rogue_4_27",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_res6_enter": {
          "id": "scene_ro4_res6_enter",
          "title": "转机",
          "description": "懦弱者在仇恨的时代中注定会被毁灭。血亲们被一个个屠戮，保护他的人也都已被杀死，敌人没有夺取他的生命，也只是想从那扭曲的戏谑中得到快乐。而他所能做的，也只有紧紧怀抱与家人们的合照。可在那之后呢，他还能做些什么吗？",
          "background": "pic_rogue_4_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_res6_1": {
          "id": "scene_ro4_res6_1",
          "title": "转机",
          "description": "他只是个普通人，终究没有勇气去反抗那些暴力的化身。不久之后，他便迎来了自己悲惨的结局。但在那样一个文明即暴力的时代，没人会为此哀悼。",
          "background": "pic_rogue_4_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_res6_2": {
          "id": "scene_ro4_res6_2",
          "title": "转机",
          "description": "他本来只是想再看一眼自己的亲人，却从相框中看到了其他的东西——那是他求而不得的，跨越种族的希望与安宁。当看到杀死自己血亲的敌人也在相框中时，他意识到了一件事：只要不以仇恨为目的滥用暴力，或许，他可以通过争斗将这相框中的希望变成现实。",
          "background": "pic_rogue_4_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_res6_3": {
          "id": "scene_ro4_res6_3",
          "title": "转机",
          "description": "有多少人因时代而屈服，又有多少人因时代而改变，他只是缺少决心，而非欠缺力量与技巧。他接受了心中的仇恨，如果只有杀戮才能为自己带来安宁，那就这样做吧。",
          "background": "pic_rogue_4_43",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin3_enter": {
          "id": "scene_ro4_fin3_enter",
          "title": "空无前兆",
          "description": "妮芙漫步在想象的边界，寻找那可遇而不可求的灵感。讲述者向死魂灵们分享了许多故事，然而，当现实的、改编的、臆想的已全部讲完，还能讲述些什么呢？死魂灵在妮芙身边游荡，不断翻检并改造着那些讲述者不愿谈及的想法，比如，一个关于魔王的预言......",
          "background": "pic_rogue_4_45",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin3_1": {
          "id": "scene_ro4_fin3_1",
          "title": "空无前兆",
          "description": "那是个关于魔王，关于阿米娅的故事，而且绝对不存在理想的结局。可是，可是，在死魂灵的催促下，妮芙还是退让了，她说服自己去接受，去讲述这个能令先祖们“心满意足”的故事。可她还没有意识到，当自己让渡出故事的主导权时，而后发生的一切，就不再受她掌控了。",
          "background": "pic_rogue_4_45",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin3_2": {
          "id": "scene_ro4_fin3_2",
          "title": "空无前兆",
          "description": "妮芙不愿去尝试讲述那黑暗又绝望的故事。她决定再独自思考一会。或许，当她想通些什么的时候，新的故事便会就此成形吧。",
          "background": "pic_rogue_4_45",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin4_enter": {
          "id": "scene_ro4_fin4_enter",
          "title": "孤注一掷",
          "description": "拉扯故事的线头，盲目地追寻终点，其结果只能是口不择言互相矛盾。当妮芙意识到这一点时，脚下已经变成了这般层叠的混沌模样。对结束的渴望唤醒了终结的意识，它披上“阿米娅”这层“外衣”从空无中现身，追溯讲述者的末日。想要阻止它，想要将之重新锁入空无，妮芙需要......",
          "background": "pic_rogue_4_46",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin4_1": {
          "id": "scene_ro4_fin4_1",
          "title": "孤注一掷",
          "description": "无力与绝望构成了“阿米娅”的开端，妮芙以此结合想象中的魔王权能，打造出了一把钥匙。将它没入终结的胸膛，向“阿米娅”伸出援手，或许就能结束这场闹剧。",
          "background": "pic_rogue_4_46",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin4_2": {
          "id": "scene_ro4_fin4_2",
          "title": "孤注一掷",
          "description": "随着讲述的停止，有那么一瞬间，妮芙被扯回了现实，但旋即她又被带回了熟悉的场景中，只是周围迫近的终结已经消失得无影无踪，她转换了思路，开始重新布置自己所要讲述的故事。",
          "background": "pic_rogue_4_46",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro4_fin5_enter": {
