          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro5_spband_18": {
          "id": "scene_ro5_spband_18",
          "title": "相随",
          "description": "易掂量着手中绝处逢生的厉运，觉得比起有所保留，他更愿意同你来一场豪赌。",
          "background": "pic_rogue_5_63",
