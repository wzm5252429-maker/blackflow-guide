          "useHiddenMusic": false
        },
        "scene_ro2_key_2": {
          "id": "scene_ro2_key_2",
          "title": "天灾信使",
          "description": "他很惊讶在这里还能遇到懂得礼仪的人！作为回礼，他送给了你两把钥匙，似乎嫌自己的礼物不够贵重，他还郑重地给你道了个歉。",
          "background": "pic_rogue_2_39",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_dice2_enter": {
          "id": "scene_ro2_dice2_enter",
          "title": "阴云如聚",
          "description": "从未见过如此厚重的阴云，它高速盘踞了整个海面，裹挟在其中的源石尘飞速旋转，带着一股摧毁万物的气势，覆盖海面的厚重壳衣被搅得粉碎。你怔怔地看着眼前酝酿中的风暴，那些灾害监测仪器统统失了效。在自然的威胁面前，生灵又能做些什么呢？",
          "background": "pic_rogue_2_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_dice2_1": {
          "id": "scene_ro2_dice2_1",
          "title": "阴云如聚",
          "description": "阴云来势汹汹，退得也毫无道理，只在倏尔之间，刚刚的异象仿佛从未出现过。狂风一停下，壳衣便再次浮上海面开始结块。或许有朝一日，它们真的能够征服自然，只愿那一刻永远不要到来。",
          "background": "pic_rogue_2_40",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_suit_enter": {
          "id": "scene_ro2_suit_enter",
          "title": "孤行的老者",
          "description": "你和一位伊比利亚老者擦肩而过，你隐约听见随从低声唤他“圣徒”。老者叫住你，有些怀疑地盘问了一通，从何而来，所为何事......你从容且得体地回答了所有问题，他的语气缓和下来。你回问了他同样的问题，你看向他，他看向你身后的海洋......“总得有人来和它做个了结。”良久，老者说。",
          "background": "pic_rogue_2_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_suit_1": {
          "id": "scene_ro2_suit_1",
          "title": "孤行的老者",
          "description": "老者向你提供了一份当地的地图，在上面标注了何处可以获得补给，并嘱咐异乡人不要在此过多逗留。",
