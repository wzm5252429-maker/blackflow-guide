        "scene_ro2_8_4": {
          "id": "scene_ro2_8_4",
          "title": "设身处地",
          "description": "恐鱼不懂得轻重缓急，你在准备食物时被狠狠咬了一口。看着其他还在喂食恐鱼的信徒们，你不禁纳闷起来，他们到底是为了什么才聚在一起，向着异质的生物献上食物呢？",
          "background": "pic_rogue_2_12",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_9_enter": {
          "id": "scene_ro2_9_enter",
          "title": "信念",
          "description": "一处军械库因深海教徒的袭击而倒塌，审判官们在击退敌人后开始清点损失。由于整体受损严重，他们愿意将一部分抢救出来的物资出售给你以挽回损失。",
          "background": "pic_rogue_2_13",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_9_1": {
          "id": "scene_ro2_9_1",
          "title": "信念",
          "description": "在受损物资中寻找可用物件时，你无意间瞥见了被抢救出来的新物资和圣人塑像，审判官们无疑正循着自己的信念行事，那你呢，你又为了什么？",
          "background": "pic_rogue_2_13",
          "titleIcon": null,
