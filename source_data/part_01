        "scene_ro2_suit_2": {
          "id": "scene_ro2_suit_2",
          "title": "孤行的老者",
          "description": "你的照明设备损坏了，而夜晚将至，老者犹豫片刻，将自己手中的提灯递给了你。“这本也是故人的遗物，与其跟着我沉入海洋，它或许更应该留在大地上。”",
          "background": "pic_rogue_2_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_suit_3": {
          "id": "scene_ro2_suit_3",
          "title": "孤行的老者",
          "description": "老者看见你的衣物有些破损，便让随从取了一件干净的便服和一些物资塞到你的手里。",
          "background": "pic_rogue_2_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_suit_4": {
          "id": "scene_ro2_suit_4",
          "title": "孤行的老者",
          "description": "你拒绝了老者的好意，但还是郑重地表达了感谢。",
          "background": "pic_rogue_2_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_suit_5": {
          "id": "scene_ro2_suit_5",
          "title": "孤行的老者",
          "description": "你接受了老者的好意，并且郑重地表达了感谢。",
          "background": "pic_rogue_2_41",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_trade4_enter": {
          "id": "scene_ro2_trade4_enter",
          "title": "为了生存",
          "description": "取得当地海民的信任后，他们将你带到了某个迷宫般的溶洞。这里深入地下，堆满了你从未见过的巨型贝类，海民们正紧张地忙碌着，他们撬开巨型贝的壳，里面的肉簇立即吐出大量的分泌物，这些分泌物被迅速收集起来，过滤、封装......大家并不交谈，尽量压低着动静，一切都井井有条，俨然是个秘密工厂。",
          "background": "pic_rogue_2_11",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_trade4_1": {
          "id": "scene_ro2_trade4_1",
          "title": "为了生存",
          "description": "你终于弄清了溶洞里的情况。这些巨型贝类竟然是恐鱼的幼卵，利用它们的分泌物制作的涂料，可以有效迷惑恐鱼群，躲避它们的追捕......虽然腥臭难忍。",
          "background": "pic_rogue_2_11",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_trade4_2": {
          "id": "scene_ro2_trade4_2",
          "title": "为了生存",
          "description": "采集的操作并不复杂，你已经相当熟练。可好几次看着那些饱满的肉簇逐渐变得干瘪时，你似乎都听到了一声带着哭腔的低号......异常幽微，或许只是刀刮到硬壳的动静吧，你并不确定。",
          "background": "pic_rogue_2_11",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_trade4_3": {
          "id": "scene_ro2_trade4_3",
          "title": "为了生存",
          "description": "工作的间歇，你听见海民们低声讨论，又有一批负责收集巨型贝的同伴没能回来。这是必须付出的代价，大家心知肚明，但不会停止。总有一些人牺牲，更多的人才能活下去。可这样的法子还能坚持多久，没有人知道。你离开了，海民们还需要为了生存而继续躲藏，而你有更重要的事情要做。",
          "background": "pic_rogue_2_11",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_trade4_4": {
          "id": "scene_ro2_trade4_4",
          "title": "为了生存",
          "description": "恐鱼群突然出现，袭击了溶洞。你猛然反应过来，那些隐约的低号，难道是贝类向恐鱼发出的讯息？即使是如此隐秘的溶洞，依然无法阻绝信息的传递吗......你从混乱中逃了出来，希望那些海民们也平安无事，希望。",
          "background": "pic_rogue_2_11",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_7_enter": {
          "id": "scene_ro2_7_enter",
          "title": "苦路",
          "description": "在审判庭的授意下，一些苦修仪式早已与重体力劳作互相结合，每个完成仪式的人会得到奖赏，但说实话......真的有人能通过这样的试炼吗？",
          "background": "pic_rogue_2_42",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_7_1": {
          "id": "scene_ro2_7_1",
          "title": "苦路",
          "description": "抱着一袋袋食物来回走动，你觉得心底里扬起一股幸福感。要继续吗？",
