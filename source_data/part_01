        "scene_ro2_exchange_3": {
          "id": "scene_ro2_exchange_3",
          "title": "梦中之会",
          "description": "你们似乎无需发声便能交流，信息以难以理解的形式在彼此之间传递。",
          "background": "pic_rogue_2_9",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_exchange_4": {
          "id": "scene_ro2_exchange_4",
          "title": "梦中之会",
          "description": "适应......转化......新的规律......界限在哪里......不止海洋......",
          "background": "pic_rogue_2_9",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_exchange_5": {
          "id": "scene_ro2_exchange_5",
          "title": "梦中之会",
          "description": "进化。超越已知的一切形态，朝着那个最完美的答案，这是无法停下的本能，这是唯一的“路”。",
          "background": "pic_rogue_2_9",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_exchange_6": {
          "id": "scene_ro2_exchange_6",
          "title": "梦中之会",
          "description": "畸形而夸张的口器几乎成为新的独立器官；断肢之上长出新的肢节；更有甚者，异常巨大的身形让经过的水流都被迫改变了方向......你突然想看一看自己的模样。",
          "background": "pic_rogue_2_9",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_exchange_7": {
          "id": "scene_ro2_exchange_7",
          "title": "梦中之会",
          "description": "并不是环境改变了你们，而是你们在以自己的改变引领环境......你们终将超越这片大地和海洋，迈入新的天地。",
          "background": "pic_rogue_2_9",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro2_exchange_8": {
          "id": "scene_ro2_exchange_8",
          "title": "梦中之会",
          "description": "你靠近同胞们。是的，你是一只海嗣，这可并没有什么异常，相反，你很适应这个身份。",
