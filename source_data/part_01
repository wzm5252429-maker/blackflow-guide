        "scene_ro2_bossa1_1": {
          "id": "scene_ro2_bossa1_1",
          "title": "狂徒妄念",
          "description": "麦种播入大海，大海溺毙麦种，无情的海洋肆意屠杀，拒绝生命。生命需要骑士，骑士便会挺身而出！杀死大海，杀死大海！！",
