        "scene_ro2_hp_1": {
          "id": "scene_ro2_hp_1",
          "title": "扎营",
          "description": "当你睁开双眼时，紧张和疲劳已经离开身体很久了。收拾好行囊，你与队友们继续探索未知的前路。",
          "background": "pic_rogue_1_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
