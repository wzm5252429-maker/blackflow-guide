          "useHiddenMusic": false
        },
        "scene_ro2_8_3": {
          "id": "scene_ro2_8_3",
          "title": "设身处地",
          "description": "或许审判官很快就会处理掉这个聚居地，但你想必还是会对这个神奇的地方记忆犹新的。",
