                }
              ]
            },
            "month_chat_rogue_2_2": {
              "sortId": 2,
              "chatItemList": [
                {
                  "floor": 1,
                  "chatZoneId": "zone_1",
                  "chatDesc": "他们无从知晓面前的人究竟还是不是审判官。",
                  "chatStoryId": "Obt/Rogue/rogue_2/MonthRecord/month_chat_rogue_2_2_1"
                },
                {
                  "floor": 3,
                  "chatZoneId": "zone_3",
                  "chatDesc": "人们只会用自己最习惯的方式去理解战争和敌人。",
                  "chatStoryId": "Obt/Rogue/rogue_2/MonthRecord/month_chat_rogue_2_2_2"
                },
                {
                  "floor": 5,
                  "chatZoneId": "zone_5",
                  "chatDesc": "她将提灯留在身后，孤身迎战海潮。直到战争结束，灯火都没有熄灭。",
                  "chatStoryId": "Obt/Rogue/rogue_2/MonthRecord/month_chat_rogue_2_2_3"
                }
              ]
            },
            "month_chat_rogue_2_3": {
              "sortId": 3,
              "chatItemList": [
                {
                  "floor": 1,
                  "chatZoneId": "zone_1",
                  "chatDesc": "旧友的棺柩排列如林，他落寞地等待着漫长的新生。",
