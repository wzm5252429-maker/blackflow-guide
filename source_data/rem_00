                {
                  "floor": 3,
                  "chatZoneId": "zone_3",
                  "chatDesc": "注视、铭记、传承。",
                  "chatStoryId": "Obt/Rogue/rogue_2/MonthRecord/month_chat_rogue_2_3_2"
                },
                {
                  "floor": 5,
                  "chatZoneId": "zone_5",
                  "chatDesc": "他如约来到永夜中央的灯塔。唯守望者直视风暴，唯他炽热如白昼。",
                  "chatStoryId": "Obt/Rogue/rogue_2/MonthRecord/month_chat_rogue_2_3_3"
                }
              ]
            },
