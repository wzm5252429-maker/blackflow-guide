          "titleIcon": null,
          "subTypeId": 6,
          "useHiddenMusic": false
        },
        "scene_ro3_res3_1": {
          "id": "scene_ro3_res3_1",
          "title": "随到随取",
          "description": "探测器找到了一座空洞，设备屏幕上的“几何体”显然就是眼前这些堆放着的盒子，它们有些是木制的、条编的，有些则是塑料的。你和同伴并不急缺物资，但本地人特制的冻汤毕竟鲜美非凡，对于吃了一路汤凝胶和脂肪聚块的你来说，不可不尝。",
          "background": "pic_rogue_3_4",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_res3_2": {
          "id": "scene_ro3_res3_2",
          "title": "随到随取",
          "description": "你伸手在这棵树的树干上摸了摸，很快按到了一块松动的树皮，密文板就堆放在它掩藏着的树洞里。按你的向导的说法，它们“都是同一款的，只要用手摩擦就能一直发热”。你们每个人都拿了一块，还剩下很多。",
          "background": "pic_rogue_3_4",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_res4_enter": {
          "id": "scene_ro3_res4_enter",
          "title": "定期维护",
          "description": "与南方人惯常的想象不同，雪原上天气晴朗的日子其实并不少——眼下就是这样一个日子。你与同伴们正七手八脚地摆出各种仪器设备，以便借此机会进行检查。远处的雪原上，裂兽的幼崽和猎物嬉戏，岩角兽的群落正在迁徙。",
          "background": "pic_rogue_3_6",
