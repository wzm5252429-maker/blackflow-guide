        "scene_ro3_sacrifice2_enter": {
          "id": "scene_ro3_sacrifice2_enter",
          "title": "安玛塔卢",
          "description": "你本以为这只是另一条兽道，可走到半路时，你突然发现，与你一同前行的，不是你的科考队员，而是一头又一头的岩角兽。在兽道尽头，巨大的白色角兽正在花圃中酣睡。角兽在祂周围吃食嬉戏，清泉从祂身旁潺潺流过。你心中突然跳出了一个念头——祂并非栖息于此，林地因祂的休憩而存在。",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 1,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_1": {
          "id": "scene_ro3_sacrifice2_1",
          "title": "安玛塔卢",
          "description": "白色角兽抖了下耳朵，木刻上的符号消弭于无形。祂接受了你的奉献，现在你想要——",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_2": {
          "id": "scene_ro3_sacrifice2_2",
          "title": "安玛塔卢",
          "description": "白色角兽甩了甩尾巴，木刻上的符号消弭于无形。祂接受了你的奉献，现在你想要——",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_3": {
          "id": "scene_ro3_sacrifice2_3",
          "title": "安玛塔卢",
          "description": "白色角兽睁开一只眼睛。祂的瞳孔清澈而纯净，让你一时忘记了一切，只是怔怔与祂对视。当你回过神来时，祂已闭上了眼睛，木刻上的符号消弭于无形。祂接受了你的奉献，现在你想要——",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_4": {
          "id": "scene_ro3_sacrifice2_4",
          "title": "安玛塔卢",
          "description": "你献上奉献，你获得回馈。当你从梦中醒来时，科考队的其他成员还在各忙各的，没有打扰你休息。",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_5": {
          "id": "scene_ro3_sacrifice2_5",
          "title": "安玛塔卢",
          "description": "你不想打扰角兽休息，于是尝了一口祂身旁流淌的清泉。泉水清冽而甘甜，心头的悲苦似乎都减少了一些。正当你回味那丝甜蜜时，你被身旁的队友摇醒。似乎刚刚发生的一切，只是一场幻梦。",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_6": {
          "id": "scene_ro3_sacrifice2_6",
          "title": "安玛塔卢",
          "description": "当你提出疑问后，那缀满冰晶的兽角便开始脱落，碎片落在了你的面前。你刚要道谢，一抬头，才发现眼前并不是什么角兽，而是一位随行萨满。梦中的启示落在手中，成了两块不祥的密文板。",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_7": {
          "id": "scene_ro3_sacrifice2_7",
          "title": "安玛塔卢",
          "description": "林地边缘气氛压抑，黑影缓缓逼近，于是你走上前去，准备给那些不速之客一个教训，好似保卫祂，就如保卫自己那般重要。",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_sacrifice2_8": {
          "id": "scene_ro3_sacrifice2_8",
          "title": "安玛塔卢",
          "description": "林地边缘火光点点，那是准备狩猎祂的异象。你拔出武器，向着不速之客的位置走去。你不太清楚自己为何要挺身而出保卫一头野兽，可能在你的潜意识中，保护祂本身，便是一种奖赏。",
          "background": "40_i06",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_enter": {
          "id": "scene_ro3_ent1_enter",
          "title": "北地巫师竞技",
          "description": "各个部族正在聚会！连误闯的你们也受到了邀请。在分享了不少故事、笑话和树汁饮料后，萨米人突然安静了下来，几个穿着打扮明显是雪祀的人步态庄严地走进了树林。聚会的萨米主持人走了过来，用一板一眼的腔调询问你愿不愿意“选择一位斗士”。在他身后，一群奇形怪状的“巨人”在雪祀们的驱使下走出了树林。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_1": {
          "id": "scene_ro3_ent1_1",
          "title": "北地巫师竞技",
          "description": "“兽角岩”大获全胜，一拳将“莫西巨草”打得翻了个四脚朝天，后者身体上附着的苔藓洒得到处都是！你选择的战争傀儡赢了！主持人哈哈大笑着送来了你的奖品。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_2": {
          "id": "scene_ro3_ent1_2",
          "title": "北地巫师竞技",
          "description": "“树眉毛”一甩身就闪过了“大雪暴”投来的巨大雪块，然后跑步接近对方，还接了一个敏捷的空翻，用腿部的重量将对手轰倒在地——你也没想到它还有这一招！你选择的战争傀儡赢了！主持人哈哈大笑着送来了你的奖品，这次是更多的食用聚块和凝胶。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_3": {
          "id": "scene_ro3_ent1_3",
          "title": "北地巫师竞技",
          "description": "“烫手斯丹”泥土的双掌上竟显现出密文！它们显然散发出了高温！“烫手斯丹”火热的连续掌击打得“异铁皮阿萨格”浑身冒火花！你选择的战争傀儡赢了！主持人哈哈大笑着送来了你的奖品，你惊奇地发现其中竟有一架微型作业平台。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_4": {
          "id": "scene_ro3_ent1_4",
          "title": "北地巫师竞技",
          "description": "像一堆枯树杈搭起的羽兽窝一样、摇摇欲坠、步履蹒跚的“老比约恩”突然大显神威，一把将“走路石墙”推倒并狂殴！你选择的战争傀儡赢了！这个结果除了你没多少人料到！操控它的年轻姑娘显然长出了一口气。“她刚接班，干得不错！”主持人一边把大奖递给你一边喊，声音几乎要被观众的叫好声掩盖。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_5": {
          "id": "scene_ro3_ent1_5",
          "title": "北地巫师竞技",
          "description": "有那么一会儿，你觉得你选中的战争傀儡肯定要赢了，但“门卫海尔玛”使出了扬起地上积雪和泥土的技能，最终更胜一筹。主持人朝你耸了耸肩，然后便笑眯眯地凑近，等着你开口说话。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_6": {
          "id": "scene_ro3_ent1_6",
          "title": "北地巫师竞技",
          "description": "巨大的战争傀儡完全不知疲倦，操控它取胜的雪祀正得意地挥舞着木杖。“下一场！再打啊！”你不禁觉得这些一反常态大吼着、吹着口哨的萨米人亲切了不少。主持人笑呵呵地把名册又朝你递来——整个聚会场上，严肃的气氛已经一点都没剩下了。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_7": {
          "id": "scene_ro3_ent1_7",
          "title": "北地巫师竞技",
          "description": "你离开了部族的聚会场，身后传来了树干与泥土碰撞的声音和人们欢乐尽兴的大笑。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent1_8": {
          "id": "scene_ro3_ent1_8",
          "title": "北地巫师竞技",
          "description": "打不过就加入！这回你选“门卫海尔玛”！你赢了！你恶狠狠地朝天空挥舞着拳头，仿佛向它释放着一切。主持人拍拍你的肩膀，微笑着说奖品已经准备好，但享乐总应有度，也许你该上路了。你看了看你的奖品，发现它比事前约定的更加豪华。",
          "background": "pic_rogue_3_1",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent2_enter": {
          "id": "scene_ro3_ent2_enter",
          "title": "最好的朋友",
          "description": "“亲爱的朋友，听我说......”在远离部族集会篝火的地方，你见到一个搂着树独自喝酒的萨米人。看到你走过来，他眼神闪躲地询问身旁的树：“你介意认识一个陌生人吗？不介意？好吧。”",
          "background": "pic_rogue_3_2",
          "titleIcon": null,
          "subTypeId": 1,
          "useHiddenMusic": false
        },
        "scene_ro3_ent2_1": {
          "id": "scene_ro3_ent2_1",
          "title": "最好的朋友",
          "description": "好吧，也许他们真的是好朋友，也许这个当地人只是想找个沉默而可靠的对象发泄一下自己的情绪，无论如何，这片土地有它自己的规矩，你应该谨慎行事。",
          "background": "pic_rogue_3_2",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent2_2": {
          "id": "scene_ro3_ent2_2",
          "title": "最好的朋友",
          "description": "他讲了部族里一名战士牺牲的故事，但你听到一半时意识到，他所说的这个人正“生活”在部族之中。不知是酒精还是故事的作用，你感到自己开始冒汗。",
          "background": "pic_rogue_3_2",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent2_3": {
          "id": "scene_ro3_ent2_3",
          "title": "最好的朋友",
          "description": "当舌头尝出那种奇妙的滋味时，你有点后悔自己这杯酒喝得太快了......你想抱怨一下这种酒有多难喝，但对方根本没有抬头看你的表情，只是笨拙地又给你倒了一杯酒。",
          "background": "pic_rogue_3_2",
          "titleIcon": null,
          "subTypeId": 0,
          "useHiddenMusic": false
        },
        "scene_ro3_ent2_4": {
          "id": "scene_ro3_ent2_4",
          "title": "最好的朋友",
          "description": "他讲了部族里一个卧病在床的老人被角兽接走，在林地最高处度过生命最后时刻的故事。讲完之后，他拍拍身旁的树，请求树也在他临死前将他接走，举到很高的地方看看太阳。",
